# SignBridge 前端环境变量示例
# 复制为 .env 并按需修改
#
# 默认情况下所有 MediaPipe 资源（wasm/模型）都自托管于 public/mediapipe/，
# 通过 Vite BASE_URL 自动适配子路径部署（如 GitHub Pages 的 /signbridge/）。
# 仅当需要切换到外部 CDN 时才设置以下变量。

# 应用显示名称
VITE_APP_NAME=手语桥 SignBridge

# MediaPipe tasks-vision wasm 基址（GestureRecognizer / PoseLandmarker / HandLandmarker 使用）
# 默认自托管：{BASE_URL}mediapipe/tasks-vision/wasm
# VITE_MEDIAPIPE_WASM_BASE_URL=https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.35/wasm

# MediaPipe Hands 旧版 wasm 基址（HandTracker 使用）
# 默认自托管：{BASE_URL}mediapipe/hands
# VITE_MEDIAPIPE_HANDS_CDN_BASE=https://cdn.jsdelivr.net/npm/@mediapipe/hands

# 预训练手势识别模型 URL
# 默认自托管：{BASE_URL}mediapipe/models/gesture_recognizer.task
# VITE_GESTURE_MODEL_URL=https://storage.googleapis.com/mediapipe-models/gesture_recognizer/gesture_recognizer/float16/1/gesture_recognizer.task

# 默认手势库 JSON 路径
# 默认：{BASE_URL}gestures.json
# VITE_GESTURE_LIBRARY_URL=/gestures.json

# 词汇库 JSON 路径
# 默认：{BASE_URL}data/vocabulary.json
# VITE_VOCABULARY_URL=/data/vocabulary.json
